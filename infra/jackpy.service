# JackPy - systemd Service Unit
# 위치: /etc/systemd/system/jackpy.service
#
# 운영 서버 구성과 동일한 형태. User와 경로(/home/<user>/jackpy)는 서버에 맞게 수정.
# 봇은 WorkingDirectory의 .env, jackpy.db(SQLite), 세션 JSON, jackpy.log를 읽고 쓴다.
#
# 설치:
#   sudo cp infra/jackpy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now jackpy
#
# 상태: systemctl status jackpy
# 로그: tail -f /home/<user>/jackpy/jackpy.log

[Unit]
Description=JackPy Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jackpy
WorkingDirectory=/home/jackpy/jackpy
ExecStart=/home/jackpy/jackpy/venv/bin/python3 -m bot.main
# 봇이 만드는 파일(DB 저널, 세션 JSON, 로그)을 소유자만 읽도록
UMask=0077
Restart=always
RestartSec=15
StandardOutput=append:/var/log/jackpy.log
StandardError=append:/var/log/jackpy.log

[Install]
WantedBy=multi-user.target
