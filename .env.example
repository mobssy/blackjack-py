# JackPy - 환경변수 예시 / Environment variables
# cp .env.example .env 후 값을 채우세요. / Copy to .env and fill in.

# BotFather에서 발급받은 봇 토큰 (필수)
# Bot token from @BotFather (required)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# 관리자 텔레그램 사용자 ID, 쉼표로 구분 (/admin, /add 사용 가능)
# Admin Telegram user IDs, comma-separated (can use /admin, /add)
ADMIN_IDS=123456789

# 데이터베이스 URL (생략 시 sqlite:///./jackpy.db)
# Database URL (defaults to sqlite:///./jackpy.db)
DATABASE_URL=sqlite:///./jackpy.db

# SQL 쿼리 로그 출력 (개발용)
# Echo SQL queries (development only)
SQL_ECHO=false
